{
  "name": "treeview-generator",
  "displayName": "TreeView Generator",
  "description": "Generate and view the directory tree structure of your workspace.",
  "version": "1.0.1",
  "engines": {
    "vscode": "^1.92.0"
  },
  "publisher": "WebNaresh",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.generateDirectoryTree",
        "title": "Generate Directory Tree"
      }
    ]
  },
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "release": "semantic-release"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "bun run package && bunx vsce package",
          "publishCmd": "bunx vsce publish --pat $VSCE_PAT --no-dependencies --packagePath *.vsix"
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WebNaresh/TreeView-Generator.git"
  },
  "keywords": [
    "vscode",
    "extension",
    "directory",
    "tree",
    "generator"
  ],
  "author": {
    "name": "WebNaresh",
    "email": "bhosalenaresh73@gmail.com"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.4",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.92.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.57.0",
    "semantic-release": "^25.0.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4"
  },
  "icon": "images/tree-view-logo.png",
  "dependencies": {
    "ignore": "^7.0.5"
  }
}
